globs:
  - ".github/workflows/**/*.yml"
  - ".github/workflows/**/*.yaml"
  - "scripts/**/*.ts"
  - "scripts/**/*.sh"
alwaysApply: false
paths:
  - ".github/workflows/**/*.yml"
  - ".github/workflows/**/*.yaml"
  - "scripts/**/*.ts"
  - "scripts/**/*.sh"
