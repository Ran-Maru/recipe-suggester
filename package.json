{
  "name": "recipe-suggester",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "cmk -p tsconfig.app.json && tsc -b && vp build",
    "check": "cmk -p tsconfig.app.json && vp check && stylelint \"src/**/*.css\" && node scripts/check-mapping.json.js",
    "format": "vp fmt .",
    "generate:css-types": "cmk -p tsconfig.app.json",
    "lint": "vp lint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vp preview",
    "print:dev-port": "bash scripts/print-worktree-dev-port.sh",
    "test:e2e": "playwright test",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:ui": "playwright test --trace on --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "prepare": "vp config"
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.33",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.4.0",
    "@css-modules-kit/stylelint-plugin": "^1.4.0",
    "@css-modules-kit/ts-plugin": "^1.4.0",
    "@playwright/test": "1.63.0",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "oxc-transform-react": "^0.149.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest-browser-react": "2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
