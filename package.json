{
  "name": "recipe-suggester",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "cmk -p tsconfig.app.json && tsc -b && vp build",
    "check": "cmk -p tsconfig.app.json && vp check && stylelint \"src/**/*.css\" && node scripts/check-mapping.json.js && node scripts/check-original-recipes.json.js",
    "format": "vp fmt .",
    "generate:css-types": "cmk -p tsconfig.app.json",
    "lint": "vp lint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vp preview",
    "print:dev-port": "bash scripts/print-worktree-dev-port.sh",
    "test:e2e": "playwright test",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:ui": "playwright test --trace on --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "prepare": "vp config"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.4.1",
    "@css-modules-kit/stylelint-plugin": "^1.4.1",
    "@css-modules-kit/ts-plugin": "^1.4.1",
    "@playwright/test": "1.64.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "catalog:",
    "knip": "^6.44.1",
    "oxc-transform-react": "^0.157.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "2.3.0",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    }
  }
}
